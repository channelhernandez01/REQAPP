# Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
# Use SERVICE_ROLE_KEY for server-side privileged operations. Keep it secret and never commit the real key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# For non-privileged public client use (e.g., browser) use the anon key instead
SUPABASE_ANON_KEY=your_anon_key_here

# If you also use a direct Postgres connection (server-side) you may have:
# DATABASE_URL=postgresql://user:password@db.host:5432/database
